@{
    ViewData["Title"] = "Kezdőlap";
}

<div class="container mt-5">
    <div class="row align-items-center">
        <div class="col-lg-6">
            <h1 class="display-4 fw-bold text-primary mb-3">Személyes Pénzügyi Figyelő</h1>
            <p class="lead text-secondary mb-4">
                Kövesse nyomon kiadásait okosan és egyszerűen. Átlátható grafikonok, 
                kategóriák szerinti bontás és exportálási lehetőség egy helyen.
            </p>
            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                <a asp-controller="Expenses" asp-action="Index" 
                   class="btn btn-primary btn-lg px-5 text-white shadow fw-bold">
                   📊 Irány a Dashboard
                </a>
            </div>
        </div>

        <div class="col-lg-6 mt-5 mt-lg-0">
            <div class="card shadow-lg border-0 bg-white mx-auto" style="max-width: 550px;">
                <div class="card-body p-4">
                    <h5 class="text-center fw-bold text-muted mb-4">KIADÁSOK ALAKULÁSA</h5>
                    
                    <div style="position: relative; height: 350px; width: 100%;">
                        <canvas id="homeIllustrationChart"></canvas>
                    </div>

                    <div class="mt-4 d-flex justify-content-center gap-3">
                        <div class="d-flex align-items-center gap-1">
                            <span style="display:inline-block; width:12px; height:12px; background-color:#0d6efd;"></span>
                            <small class="text-muted">2026</small>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span style="display:inline-block; width:12px; height:12px; background-color:#ffc107;"></span>
                            <small class="text-muted">2025</small>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <span style="display:inline-block; width:12px; height:12px; background-color:#198754;"></span>
                            <small class="text-muted">2024</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('homeIllustrationChart');
        
        // Itt vesszük át a valódi adatokat a C# kódból
        const realData = @Html.Raw(Json.Serialize(ViewBag.QuarterlyData));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['1. Negyedév', '2. Negyedév', '3. Negyedév', '4. Negyedév'],
                datasets: [
                    {
                        label: '@ViewBag.CurrentYear',
                        data: realData, // Ez már a te adatbázisodból jön!
                        backgroundColor: '#0d6efd',
                        borderRadius: 5,
                        barPercentage: 0.6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { 
                        beginAtZero: true,
                        grid: { color: '#f0f0f0' },
                        ticks: { 
                            callback: function(value) { return value.toLocaleString() + ' Ft'; }
                        }
                    },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}