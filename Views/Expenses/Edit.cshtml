@model WebApplication1.Models.Expense
@using WebApplication1.Models

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Kiadás szerkesztése</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                @* Ez a rejtett mező mondja meg a szervernek, melyik rekordot kell frissíteni *@
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Megnevezés</label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label">Összeg (Ft)</label>
                    <input asp-for="Amount" class="form-control" type="number" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label">Kategória</label>
                    <select asp-for="Category" class="form-select" 
                            asp-items="Html.GetEnumSelectList<ExpenseCategory>()">
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CreatedAt" class="form-label">Dátum</label>
                    <input asp-for="CreatedAt" class="form-control" type="date" />
                    <span asp-validation-for="CreatedAt" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Módosítások mentése</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Mégse</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}