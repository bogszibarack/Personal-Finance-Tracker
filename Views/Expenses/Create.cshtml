@model WebApplication1.Models.Expense
@using WebApplication1.Models

<div class="container mt-4">
    <h2>Új kiadás hozzáadása</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                @* Validációs összesítő *@
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Megnevezés</label>
                    <input asp-for="Description" class="form-control" placeholder="pl. Benzin vagy Tesco" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label">Összeg (Ft)</label>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label">Kategória</label>
                    @* Ez a sor generálja az Enum-ból a legördülő menüt *@
                    <select asp-for="Category" class="form-select" 
                            asp-items="Html.GetEnumSelectList<ExpenseCategory>()">
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CreatedAt" class="form-label">Dátum</label>
                    <input asp-for="CreatedAt" class="form-control" type="date" 
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="CreatedAt" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success">Mentés</button>
                    <a asp-action="Index" class="btn btn-secondary">Vissza a listához</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}